# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_USER=mlops           # Database username
POSTGRES_PASSWORD=mlops      # Database password (CHANGE IN PRODUCTION)
POSTGRES_DB=mlops             # Database name
POSTGRES_HOST=postgres        # PostgreSQL service name in Docker network
POSTGRES_PORT=5432           # PostgreSQL port

# =============================================================================
# MinIO Configuration (S3-compatible storage)
# =============================================================================
MINIO_ROOT_USER=minio        # MinIO root username
MINIO_ROOT_PASSWORD=minio123  # MinIO root password (CHANGE IN PRODUCTION)
MINIO_ENDPOINT=minio:9000     # MinIO service name in Docker network
MINIO_BUCKET=datasets        # Bucket for datasets
MODELS_BUCKET=models       # Bucket for trained models

# =============================================================================
# MLflow Configuration
# =============================================================================
MLFLOW_TRACKING_URI=http://mlflow:5000  # MLflow server URI in Docker network

# =============================================================================
# Service Ports (mapped to host)
# =============================================================================
ORCHESTRATOR_PORT=8000       # Port for orchestrator service
INFERENCE_PORT=8001           # Port for inference service
MONITORING_PORT=8002          # Port for monitoring service

# =============================================================================
# Worker Configuration
# =============================================================================
WORKER_POLL_INTERVAL=5       # Seconds between job polling attempts
TMP_DIR=/tmp       # Temporary folder for dataset
TRAINING_SCRIPT=pipelines/first_ml_baseline/train.py       # Path to the ML pipeline
TRAINING_TIMEOUT=300       # Timeout for training pipeline
MLFLOW_EXPERIMENT=first_ml_baseline       # Name of the MLflow experiment
RECOVERY_TIMEOUT_MINUTES=30
